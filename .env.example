# API Keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter (for DeepSeek, etc.)
# OPENROUTER_API_KEY=your_openrouter_key_here
# LLM_MODEL=deepseek/deepseek-chat-v3.1
# LLM_API_BASE=https://openrouter.ai/api/v1

# Or use other providers
# ANTHROPIC_API_KEY=your_anthropic_key
# GEMINI_API_KEY=your_gemini_key

# Pathway Configuration
DATA_DIR=./data_room
HOST=0.0.0.0
PORT=8000

# Embedding Model (choose one)
EMBEDDER_TYPE=sentence-transformers  # Options: openai, sentence-transformers, litellm, gemini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Model
LLM_MODEL=gpt-4o-mini  # Options: gpt-4o-mini, deepseek/deepseek-chat-v3.1, claude-3-5-sonnet-20241022
LLM_API_BASE=  # Leave empty for OpenAI, or set to https://openrouter.ai/api/v1 for OpenRouter

# Chunk Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Search Settings
TOP_K=5
SEARCH_TYPE=hybrid  # Options: vector, keyword, hybrid
